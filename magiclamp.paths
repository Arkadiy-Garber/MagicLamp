## adding paths:
## Writes environment variables into the conda env's activate.d hook so that
## every v3 genie can locate its HMM library and the R scripts.
## Each *_hmms variable name matches what the corresponding genie reads at runtime;
## each path points at the matching subdirectory under hmms/.
MAGICLAMP_DIR="$(pwd)"
ACTIVATE_D="${CONDA_PREFIX}/etc/conda/activate.d"
mkdir -p "${ACTIVATE_D}"

cat > "${ACTIVATE_D}/env_vars.sh" <<EOF
#!/bin/sh
export rscripts="${MAGICLAMP_DIR}/rscripts"
export PATH="${MAGICLAMP_DIR}:\$PATH"

# --- v3 genie HMM libraries ---
export iron_hmms="${MAGICLAMP_DIR}/hmms/iron"          # FeGenie
export litho_hmms="${MAGICLAMP_DIR}/hmms/litho"        # LithoGenie
export lux_hmms="${MAGICLAMP_DIR}/hmms/lux"            # Lucifer
export atp_hmms="${MAGICLAMP_DIR}/hmms/atp"            # ATPGenie
export portna_hmms="${MAGICLAMP_DIR}/hmms/portna"      # PortGenie
export rnf_hmms="${MAGICLAMP_DIR}/hmms/rnf"            # RnfGenie
export abx_hmms="${MAGICLAMP_DIR}/hmms/antibiotics"    # AbxGenie
export motility_hmms="${MAGICLAMP_DIR}/hmms/motility"  # MotiliGenie
export ribo_hmms="${MAGICLAMP_DIR}/hmms/ribo"          # RiboGenie
export resist_hmms="${MAGICLAMP_DIR}/hmms/resist"      # ResistiGenie
export spore_hmms="${MAGICLAMP_DIR}/hmms/spore"        # SporeGenie
EOF

## Warn (do not fail) if any expected HMM subdirectory is missing on disk.
for d in iron litho lux atp portna rnf antibiotics motility ribo resist spore; do
    if [ ! -d "${MAGICLAMP_DIR}/hmms/${d}" ]; then
        printf "  [warning] expected HMM directory not found: hmms/%s\n" "${d}" >&2
    fi
done
